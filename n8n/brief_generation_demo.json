{
  "name": "Beacon AI - Sector Brief Generation (Demo)",
  "nodes": [
    {
      "id": "chat-trigger",
      "name": "When chat message received",
      "type": "@n8n/n8n-nodes-langchain.chatTrigger",
      "typeVersion": 1.1,
      "position": [-620, 0],
      "parameters": {
        "public": true,
        "options": {
          "title": "Beacon AI - Sector Brief Generator",
          "subtitle": "Type one of the listed sectors to generate a partner-ready brief"
        }
      }
    },
    {
      "id": "config",
      "name": "Config",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [-400, 0],
      "notes": "Fill both fields in from the n8n UI (don't commit real values here): bridgeUrl = your current cloudflared/ngrok tunnel URL for src/bridge_server.py (e.g. https://xxxx.trycloudflare.com), bridgeToken = the BRIDGE_TOKEN value from your local .env.",
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "bridge-url",
              "name": "bridgeUrl",
              "type": "string",
              "value": "https://REPLACE-WITH-YOUR-TUNNEL-URL"
            },
            {
              "id": "bridge-token",
              "name": "bridgeToken",
              "type": "string",
              "value": "REPLACE-WITH-YOUR-BRIDGE_TOKEN"
            }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "get-sectors",
      "name": "Get Sectors",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [-160, 0],
      "parameters": {
        "url": "={{ $json.bridgeUrl }}/sectors",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-Bridge-Token",
              "value": "={{ $json.bridgeToken }}"
            }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "match-sector",
      "name": "Match Sector",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [80, 0],
      "parameters": {
        "jsCode": "const sectors = $input.first().json.sectors;\nconst chatInput = ($('When chat message received').first().json.chatInput || '').trim();\nconst matchedSector = sectors.find(s => s.toLowerCase() === chatInput.toLowerCase()) || null;\n\nreturn [{ json: { sectors, chatInput, matchedSector } }];"
      }
    },
    {
      "id": "sector-selected-if",
      "name": "Sector Selected?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [320, 0],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "combinator": "and",
          "conditions": [
            {
              "id": "sector-not-empty",
              "leftValue": "={{ $json.matchedSector }}",
              "rightValue": "",
              "operator": {
                "type": "string",
                "operation": "notEmpty",
                "singleValue": true
              }
            }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "generate-brief",
      "name": "Generate Brief",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [560, -100],
      "notes": "matchedSector only ever holds a value copied verbatim from the sectors list (validated in Match Sector above), so it's safe to pass straight through.",
      "parameters": {
        "url": "={{ $('Config').first().json.bridgeUrl }}/brief",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-Bridge-Token",
              "value": "={{ $('Config').first().json.bridgeToken }}"
            }
          ]
        },
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "sector",
              "value": "={{ $json.matchedSector }}"
            }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "format-brief-output",
      "name": "Format Brief Output",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [800, -100],
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "output-field",
              "name": "output",
              "type": "string",
              "value": "={{ $json.brief }}"
            }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "ask-for-sector",
      "name": "Ask For Sector",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [560, 100],
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "output-field",
              "name": "output",
              "type": "string",
              "value": "=Pick a sector to generate a brief for. Reply with the exact sector name from this list:\n\n{{ $json.sectors.map(s => '- ' + s).join('\\n') }}"
            }
          ]
        },
        "options": {}
      }
    }
  ],
  "connections": {
    "When chat message received": {
      "main": [
        [
          { "node": "Config", "type": "main", "index": 0 }
        ]
      ]
    },
    "Config": {
      "main": [
        [
          { "node": "Get Sectors", "type": "main", "index": 0 }
        ]
      ]
    },
    "Get Sectors": {
      "main": [
        [
          { "node": "Match Sector", "type": "main", "index": 0 }
        ]
      ]
    },
    "Match Sector": {
      "main": [
        [
          { "node": "Sector Selected?", "type": "main", "index": 0 }
        ]
      ]
    },
    "Sector Selected?": {
      "main": [
        [
          { "node": "Generate Brief", "type": "main", "index": 0 }
        ],
        [
          { "node": "Ask For Sector", "type": "main", "index": 0 }
        ]
      ]
    },
    "Generate Brief": {
      "main": [
        [
          { "node": "Format Brief Output", "type": "main", "index": 0 }
        ]
      ]
    }
  },
  "active": false,
  "settings": {
    "executionOrder": "v1"
  },
  "pinData": {}
}
