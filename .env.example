# LLM provider (used by src/briefs.py)
OPENAI_API_KEY=
# Optional backup keys -- Beacon AI automatically retries a call against OPENAI_API_KEY_2,
# then OPENAI_API_KEY_3, if the prior key hits a rate limit or runs out of quota.
# Safe to leave blank.
OPENAI_API_KEY_2=
OPENAI_API_KEY_3=

# Optional -- SMTP credentials for the india-trend-radar "Weekly trend digest" email
# subscription. Leave SMTP_HOST blank to disable the feature (the toggle stays usable, but
# submitting shows a clear "not configured" message instead of failing silently).
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=

# LangSmith observability (current env var names — the older LANGCHAIN_*
# names still work in some SDK versions but LANGSMITH_* is what's current)
LANGSMITH_TRACING=true
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=beacon-ai

# n8n bridge server (src/bridge_server.py) — any random string; must match
# the "Config" node's bridgeToken field in the n8n workflow.
BRIDGE_TOKEN=

# Public PDF sharing host for final-analysis exports.
# Default: https://0x0.st
SHARE_UPLOAD_ENDPOINT=https://0x0.st
